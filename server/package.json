{
  "name": "learning-reminder-server",
  "version": "1.0.0",
  "private": true,
  "description": "Learning Reminder API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "node ./scripts/start-prod.mjs",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 --import ./test-setup-env.ts src/owned.test.ts src/ownership.idor.test.ts src/jwt.test.ts src/rateLimitKey.test.ts src/reviewLogin.test.ts src/botProtection.test.ts src/appleAuth.test.ts src/auth.session.test.ts src/auth.refresh.test.ts src/auth.refresh-limit.test.ts src/timezone.test.ts src/auth.login-code.test.ts src/google.oauth.test.ts src/auth.onboarding.test.ts src/entitlements.test.ts src/stripe.config.test.ts src/billing.webhook.test.ts src/food-scan.test.ts src/finance-scan.test.ts src/finance.limits.test.ts src/nutrition.profile.test.ts src/userName.test.ts",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "stripe": "^22.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=20"
  }
}
