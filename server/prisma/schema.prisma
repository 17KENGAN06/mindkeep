generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MaterialStatus {
  ACTIVE
  ARCHIVED
}

enum ReminderStatus {
  PENDING
  COMPLETED
  OVERDUE
  SKIPPED
}

enum ReminderIntervalType {
  THREE_DAYS
  SEVEN_DAYS
  THIRTY_DAYS
}

enum NotificationType {
  REVIEW_DUE
  REVIEW_OVERDUE
  SYSTEM
}

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PRO
}

enum PlanInterval {
  MONTH
  YEAR
}

enum UserReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BudgetCurrency {
  UAH
  EUR
  USD
  PLN
  GBP
  CHF
  CZK
  RON
  TRY
  GEL
  KZT
  RUB
}

enum BudgetOperationType {
  INCOME
  EXPENSE
}

enum BudgetMoneyKind {
  CASH
  ELECTRONIC
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  timezone     String   @default("Europe/Helsinki")
  role         UserRole @default(USER)
  emailVerified Boolean @default(true)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  plan                 UserPlan      @default(FREE)
  planInterval         PlanInterval?
  planExpiresAt        DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  betaTester           Boolean       @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories         Category[]
  materials          LearningMaterial[]
  reminders          ReviewReminder[]
  notifications      Notification[]
  review             UserReview?
  budgetSettings     BudgetSettings?
  budgetCategories   BudgetCategory[]
  budgetOperations   BudgetOperation[]
  dailyTasks         DailyTask[]
  notes              Note[]
  nutritionSettings  NutritionSettings?
  meals              Meal[]
  waterDays          WaterDay[]
  weightDays         WeightDay[]
  habits             Habit[]
  habitLogs          HabitLog[]
  auditEvents        AdminAuditEvent[]
  sessions           AuthSession[]
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  kind             String    @default("browser")
  expiresAt        DateTime
  revokedAt        DateTime?
  refreshTokenHash String?
  refreshExpiresAt DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

enum AdminAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  GOOGLE_LOGIN
  PASSWORD_CHANGED
  PASSWORD_RESET
  REVIEW_APPROVED
  REVIEW_REJECTED
  BETA_GRANTED
  BETA_REVOKED
}

model AdminAuditEvent {
  id          String           @id @default(cuid())
  action      AdminAuditAction
  actorUserId String?
  targetType  String?
  targetId    String?
  createdAt   DateTime         @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
}

model UserReview {
  id        String           @id @default(cuid())
  rating    Int
  text      String
  location  String?
  locale    String           @default("en")
  status    UserReviewStatus @default(PENDING)
  userId    String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([status, locale, createdAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials LearningMaterial[]

  @@unique([userId, name])
  @@index([userId])
}

model LearningMaterial {
  id          String         @id @default(cuid())
  title       String
  description String         @default("")
  content     String         @default("")
  question    String?
  answer      String?
  sourceUrl   String?
  learnedAt   DateTime
  status      MaterialStatus @default(ACTIVE)
  categoryId  String?
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reminders     ReviewReminder[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, status])
  @@index([categoryId])
  @@index([learnedAt])
}

model ReviewReminder {
  id                     String               @id @default(cuid())
  intervalType           ReminderIntervalType
  sequenceNumber         Int
  scheduledAt            DateTime
  status                 ReminderStatus       @default(PENDING)
  completedAt            DateTime?
  notificationCreatedAt  DateTime?
  materialId             String
  userId                 String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  material      LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification  Notification?

  @@unique([materialId, intervalType])
  @@index([userId])
  @@index([scheduledAt])
  @@index([userId, scheduledAt, status])
  @@index([status, scheduledAt])
}

model Notification {
  id         String           @id @default(cuid())
  title      String
  message    String
  type       NotificationType
  isRead     Boolean          @default(false)
  materialId String?
  reminderId String?          @unique
  userId     String
  createdAt  DateTime         @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  material LearningMaterial? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  reminder ReviewReminder?   @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@index([createdAt])
}

model BudgetSettings {
  id              String         @id @default(cuid())
  displayCurrency BudgetCurrency @default(EUR)
  openingBalance  Float          @default(0)
  openingCurrency BudgetCurrency @default(EUR)
  userId          String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BudgetCategory {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations BudgetOperation[]

  @@unique([userId, name])
  @@index([userId])
}

model BudgetOperation {
  id         String              @id @default(cuid())
  date       DateTime
  amount     Float
  currency   BudgetCurrency      @default(EUR)
  type       BudgetOperationType
  moneyKind  BudgetMoneyKind     @default(ELECTRONIC)
  comment    String              @default("")
  categoryId String?
  userId     String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  category BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([userId, date])
  @@index([userId])
  @@index([userId, moneyKind])
}

model ExchangeRate {
  id        String         @id @default(cuid())
  date      DateTime
  currency  BudgetCurrency
  rateToRub Float
  createdAt DateTime       @default(now())

  @@unique([date, currency])
  @@index([date])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  sourceUrl String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model DailyTask {
  id          String    @id @default(cuid())
  title       String
  /** Minutes allocated for this task on that day */
  minutes     Int
  date        DateTime
  completed   Boolean   @default(false)
  completedAt DateTime?
  note        String    @default("")
  splitCount  Int       @default(1)
  splitDone   Int       @default(0)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, completed, date])
}

model NutritionSettings {
  id           String   @id @default(cuid())
  calorieGoal  Int      @default(2000)
  waterGoal    Int      @default(8)
  weightGoal   Float?
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Meal {
  id        String   @id @default(cuid())
  title     String
  calories  Int
  date      DateTime
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model WaterDay {
  id        String   @id @default(cuid())
  glasses   Int      @default(0)
  date      DateTime
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model WeightDay {
  id        String   @id @default(cuid())
  kg        Float
  date      DateTime
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Habit {
  id            String   @id @default(cuid())
  title         String
  isActive      Boolean  @default(true)
  targetPerWeek Int      @default(7)
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
  @@index([userId, isActive])
}

model HabitLog {
  id        String   @id @default(cuid())
  date      DateTime
  completed Boolean  @default(true)
  habitId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId])
  @@index([userId, date])
}

model GoogleSignInTicket {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  idToken   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  LOGIN_CODE
}

model EmailToken {
  id        String         @id @default(cuid())
  type      EmailTokenType
  email     String
  codeHash  String         @unique
  payload   String?
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([email, type])
  @@index([expiresAt])
}
