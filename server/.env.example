# Railway Postgres plugin provides this automatically in production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learning_reminder?schema=public

# Auth — use ≥32 characters in production
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth 2.0 Web client ID (same value as client VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# Canonical API origin used for Google redirect_uri (do not spoof via Host)
API_PUBLIC_URL=https://api.mindkeep.cloud
# Add this Authorized redirect URI on the same Web client:
# https://api.mindkeep.cloud/api/auth/google/callback

# Frontend origin for CORS + cookies (Hostinger domain, no trailing slash)
CLIENT_URL=https://your-domain.com

NODE_ENV=production
PORT=4000

# Protects POST /api/internal/cron/reminders
CRON_SECRET=change-me-cron-secret

# Prefer Railway Cron in production
ENABLE_NODE_CRON=false

# Resend — required in production for signup confirmation, password reset, and contact
# EMAIL_FROM is the user-facing From (verify / reset), e.g. MindKeep <contact@mindkeep.cloud>
# Contact-form delivery uses hello@mindkeep.cloud so Hostinger does not treat it as spoofed inbox mail
EMAIL_FROM=
RESEND_API_KEY=
# Future channels
TELEGRAM_BOT_TOKEN=

# Comma-separated emails promoted to ADMIN on login/register
ADMIN_EMAILS=kengangenkay@gmail.com

# When true, only ADMIN users may sign in / use protected API (set false to reopen)
MAINTENANCE_MODE=false

# Stripe Checkout on the website only. Production must use live keys (sk_live_... or rk_live_...).
# Sandbox sk_test_ keys are ignored when NODE_ENV=production.
# Do not commit real keys. Live webhook: https://api.mindkeep.cloud/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Google AI Studio key for Pro food scan on the mobile website. Leave empty to keep scan offline (503).
# Do not commit the real key. Default model is gemini-3.5-flash-lite; 2.5/2.0 are fallbacks.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
