# Railway Postgres plugin provides this automatically in production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learning_reminder?schema=public

# Auth — use ≥32 characters in production
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin for CORS + cookies (Hostinger domain, no trailing slash)
CLIENT_URL=https://your-domain.com

NODE_ENV=production
PORT=4000

# Protects POST /api/internal/cron/reminders
CRON_SECRET=change-me-cron-secret

# Prefer Railway Cron in production
ENABLE_NODE_CRON=false

# Future channels
EMAIL_FROM=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# Comma-separated emails promoted to ADMIN on login/register
ADMIN_EMAILS=kengangenkay@gmail.com
