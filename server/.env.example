# PostgreSQL (Railway Postgres plugin provides this automatically)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learning_reminder?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin for CORS + cookies (Railway client URL, no trailing slash)
CLIENT_URL=http://localhost:5173

NODE_ENV=development
PORT=4000

# Protects POST /api/internal/cron/reminders
CRON_SECRET=change-me-cron-secret

# Optional local in-process cron (prefer Railway Cron in production)
ENABLE_NODE_CRON=false

# Future channels
EMAIL_FROM=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
