{
  "expo": {
    "name": "MindKeep",
    "slug": "mindkeep",
    "owner": "17kengan06",
    "scheme": "mindkeep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "primaryColor": "#8eefb4",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07110d"
    },
    "userInterfaceStyle": "automatic",
    "extra": {
      "privacyPolicyUrl": "https://mindkeep.cloud/privacy",
      "supportUrl": "https://mindkeep.cloud/contact",
      "marketingUrl": "https://mindkeep.cloud",
      "eas": {
        "projectId": "e3304cc5-f62e-4cd8-b580-ed47b2b6c118"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cloud.mindkeep.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "MindKeep",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["https", "http"]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "cloud.mindkeep.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#07110d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "mindkeep"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "platforms": ["ios", "android"],
    "runtimeVersion": "exposdk:57.0.0",
    "newArchEnabled": true,
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ]
  }
}
