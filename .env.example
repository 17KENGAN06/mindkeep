# Shared reference — copy into server/.env and client/.env (or Railway Variables)

# ---- Server (Railway API service) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learning_reminder?schema=public
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=https://your-frontend.up.railway.app
NODE_ENV=production
PORT=4000
CRON_SECRET=change-me-cron-secret
ENABLE_NODE_CRON=false
EMAIL_FROM=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# ---- Client (Railway frontend service, set at BUILD time) ----
VITE_API_URL=https://your-api.up.railway.app
