# Shared reference — copy into server/.env and client/.env (or set in Railway / Hostinger build)

# ---- Server (Railway API service) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learning_reminder?schema=public
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
CLIENT_URL=https://your-domain.com
NODE_ENV=production
PORT=4000
CRON_SECRET=change-me-cron-secret-min-16
ENABLE_NODE_CRON=false
EMAIL_FROM=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=

# Comma-separated emails that get ADMIN role (case-insensitive)
ADMIN_EMAILS=kengangenkay@gmail.com

# ---- Client (build-time for Hostinger static upload) ----
# Set before `npm run build` in client/:
VITE_API_URL=https://your-api.up.railway.app
