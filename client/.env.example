# API URL (no trailing slash). Set at BUILD time before uploading client/dist to Hostinger.
# Example: https://your-api.up.railway.app
VITE_API_URL=https://your-api.up.railway.app

# Google OAuth 2.0 Web client ID (public; must match server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
